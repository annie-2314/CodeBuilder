# Groq Cloud API key (required)
# Get one at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Default LLM model on Groq (overridable in the UI)
# Options: openai/gpt-oss-120b | qwen/qwen3.6-27b | openai/gpt-oss-20b
GROQ_DEFAULT_MODEL=openai/gpt-oss-120b

# Where generated apps are written (relative to repo root or absolute)
GENERATED_PROJECTS_DIR=generated_projects

# FastAPI server (used by the React frontend)
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Agent recursion limit (coder loop safety)
AGENT_RECURSION_LIMIT=100

# Optional: lower temperature for more deterministic code
LLM_TEMPERATURE=0.1
